
#   /control/execute /Users/carter_chapman/DAMICM_G4Sims/DAMICMSims/DamicG4/cosmo_test.mac

/control/execute /Users/carter_chapman/DAMICM_G4Sims/DAMICMSims/DamicG4/vis.mac


#/run/initialize

# --- Muon source: 6 discrete points on a 500mm-radius shell centered on
# the 3-CCD cluster (a coarse, macro-only approximation of a solid-angle
# acceptance scan), each firing straight at one specific CCD's own
# center so every CCD gets hit from more than one direction. A true
# continuous random shell with automatic aim-at-target isn't something
# the existing /damic/gun/... commands support (confirmed by reading
# DAMICParticleSource.cc: doshape Sphere samples the whole volume, not
# just the surface, and none of the direction modes compute a per-event
# aim vector toward a fixed target from a varying start point -- that
# would need a new C++ source mode) -- this is the deliberately-chosen
# macro-only approximation instead: 6 hand-picked shell points (the
# cardinal directions from the CCD cluster's own centroid), each with
# its own precomputed fixed direction. 1 GeV muons are minimum-ionizing
# and only lose a small fraction of their energy crossing modest
# lead/steel thicknesses, so they should reliably punch through
# whatever real shielding sits between each shell point and its target
# CCD and still register a hit.
#
# NOTE: this is NOT the cosmogenic gun mode from before -- doshape Para
# is only available on the general /damic/gun/position/... commands
# (/damic/gun/cosmogenic/position only supports "cuboid"), so this uses
# a plain mono-energetic mu- source instead of the cosmogenic
# energy/angle spectrum.
/damic/gun/particle mu-
/damic/gun/energy/mono 1 GeV


/tracking/verbose 1

# Shell centered on C = (20.65, 152.4, 48.06)mm, the average of
# CCDInStorageBox1Pos (5.89375,152.4,48.26), CCDInStorageBox2Pos
# (19.04375,152.4,48.06), and CCDInStorageBox3Pos (37.01975,152.4,
# 47.86). Radius 500mm clears lead_castle_full's real extent (~787mm
# wide, ~673mm tall) with margin. Each shell point is C + 500mm*u for a
# cardinal unit vector u; each direction below is the exact unit vector
# from that point to one specific CCD's own center (normalize(target -
# point)), cycled across the 3 CCDs so each gets hit from 2 different
# shell points.

# --- Point 1: +X shell point, aimed at CCD1 ---
/damic/gun/position/doshape Para
/damic/gun/position/centerx 520.65 mm
/damic/gun/position/centery 152.4 mm
/damic/gun/position/centerz 48.06 mm
/damic/gun/position/parax 0.5 mm
/damic/gun/position/paray 0.5 mm
/damic/gun/position/paraz 0.5 mm
/damic/gun/direction/oned
/damic/gun/direction/onedX -1
/damic/gun/direction/onedY 0
/damic/gun/direction/onedZ 0.0004
/analysis/setFileName cosmo_test.root
/run/beamOn 1

