# cosmo_tes.mac
#
# Draws the apparatus geometry, then fires cosmogenic muons from a
# horizontal "sky plane" source positioned above it, so you can watch
# the tracks penetrate the apparatus and interact with its materials.
#
# Muon energy/angle are drawn from Geant4's own built-in realistic
# cosmic-ray muon spectrum (DAMICParticleSource::GenerateMuonEnergyDist
# / GenerateMuonAngleDist): energy 10 MeV-5 TeV (mostly GeV-scale,
# minimum-ionizing), angle following an underground zenith-angle
# distribution (theta=0 = straight down). This is NOT a fixed 1 MeV --
# the cosmogenic code path always uses its own spectrum and ignores
# /damic/gun/energy/mono; a literal 1 MeV muon (barely above its own
# ~105.7 MeV rest mass) wouldn't travel far enough to show a real track
# anyway.
#
# MUST be run from an interactive session, not passed as the batch
# macro argument -- DAMICG4 only creates the vis manager (and hence
# only understands /vis/* commands) when launched with no macro on the
# command line. Launch with just the gdml file:
#   cd .../HFIR_gdml/HFIR_gdml/run
#   /path/to/build/DAMICG4 ../gdml/apparatus.gdml
# then, in the Qt window's command line, type:
#   /control/execute /Users/carter_chapman/DAMICM_G4Sims/DAMICMSims/DamicG4/cosmo_tes.mac

/control/execute /Users/carter_chapman/DAMICM_G4Sims/DAMICMSims/DamicG4/vis.mac

# --- Cosmogenic muon source ---
# Setting particleType also switches the gun into cosmogenic mode.
/damic/gun/cosmogenic/particleType muon
/damic/gun/cosmogenic/angularDist cosmo
/damic/gun/cosmogenic/position cuboid

# Source: a thin (10mm) horizontal slab centered 900mm above the
# origin (global Z is vertical in this apparatus -- confirmed from
# table.gdml/cryo_fix.gdml bounding boxes), spanning +/-900mm in X
# and Y. That's comfortably above and wider than lead_castle_full,
# the tallest/widest real part (~673mm tall, ~787mm across), so muons
# start above the whole apparatus and travel down (-Z) through it.
/damic/gun/cosmogenic/srcCentre 0 0 900 mm
/damic/gun/cosmogenic/sizeXYZ 1800 1800 10 mm

/analysis/setFileName cosmo_test.root

# Adjust up/down as needed -- higher-energy muons can shower and add
# a lot of secondary tracks to the view.
/run/beamOn 30
